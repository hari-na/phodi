# Copy to scripts/.env and fill in.

# For lesson content generation (Claude):
ANTHROPIC_API_KEY=

# For pronunciation audio. Default provider is Sarvam (purpose-built
# for Indian languages, free credits on signup, then ~₹0.30/1000 chars).
# Sign up at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Alternative TTS provider — only needed if you pass --provider azure.
# Create a Speech resource at https://portal.azure.com (free tier 500k chars/month).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
